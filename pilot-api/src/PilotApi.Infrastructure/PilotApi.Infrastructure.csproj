<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure implements the interfaces Application declares. In the real
    ID card API this is where EF Core and the member database live; here it is
    two in-memory stubs, so the sample runs with no database and no network.
  -->

  <PropertyGroup>
    <RootNamespace>PilotApi.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PilotApi.Application\PilotApi.Application.csproj" />
  </ItemGroup>

</Project>
