<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Application layer depends on Domain and nothing else. In particular it
    has no reference to ASP.NET Core, which is why nothing in here can reach for
    HttpContext or ClaimsPrincipal — the caller arrives as ICallerIdentity
    instead. See Abstractions/ICallerIdentity.cs for why that matters.
  -->

  <PropertyGroup>
    <RootNamespace>PilotApi.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PilotApi.Domain\PilotApi.Domain.csproj" />
    <!-- Abstractions only: ICallerIdentity and IMemberIdentityResolver, with no ASP.NET
         Core dependency. Referencing the full MemberPortal.Authentication.Descope package
         here would drag the web framework into a layer that is not supposed to know HTTP
         exists, which is precisely why that package is split in two. -->
    <ProjectReference Include="..\..\..\packages\MemberPortal.Authentication.Descope.Abstractions\MemberPortal.Authentication.Descope.Abstractions.csproj" />
  </ItemGroup>

</Project>
