<Project Sdk="Microsoft.NET.Sdk">

  <!--
    These tests never touch the network and never need a Descope project. The
    test host swaps Descope's JWKS for an in-memory signing key, so the tokens
    under test are minted locally. See PilotApiFactory.cs.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.30" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PilotApi.Api\PilotApi.Api.csproj" />
  </ItemGroup>

</Project>
