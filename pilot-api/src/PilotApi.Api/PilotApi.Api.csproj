<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The only project that knows Descope exists.

    Microsoft.AspNetCore.Authentication.JwtBearer is the entire authentication
    dependency — there is no Descope .NET SDK reference here, and none is needed.
    Descope publishes a standard OIDC discovery document and JWKS endpoint, so
    the framework's own JWT handler validates its tokens, including key rotation.
    Taking an SDK dependency would buy nothing and would put a vendor package in
    the request path of every call to the ID card API.
  -->

  <PropertyGroup>
    <RootNamespace>PilotApi.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PilotApi.Application\PilotApi.Application.csproj" />
    <ProjectReference Include="..\PilotApi.Infrastructure\PilotApi.Infrastructure.csproj" />
    <!-- A ProjectReference rather than a PackageReference on purpose: in this repo it
         means the pilot's tests exercise the package's own code, which is the cheapest
         possible proof the package works. Consuming services use a PackageReference from
         Nexus instead. -->
    <ProjectReference Include="..\..\..\packages\MemberPortal.Authentication.Descope\MemberPortal.Authentication.Descope.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PilotApi.Api.Tests" />
  </ItemGroup>

</Project>
